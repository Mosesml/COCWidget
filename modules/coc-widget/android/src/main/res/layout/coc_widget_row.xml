<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/coc_row_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F0F6E8" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/coc_row_level" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C3D3B6" android:textSize="10sp" android:paddingTop="2dp" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <Chronometer android:id="@+id/coc_row_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#D8E9BC" android:textSize="14sp" android:textStyle="bold" android:paddingStart="8dp" />
</LinearLayout>
