<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/coc_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/coc_widget_background">
  <TextView android:id="@+id/coc_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="COCWidget" android:textSize="19sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/coc_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your village, one step ahead" android:textSize="11sp" android:textColor="#B8B8B8" android:paddingTop="6dp" android:paddingBottom="12dp" android:maxLines="1" android:ellipsize="end" />
  <View android:id="@+id/coc_rule" android:layout_width="match_parent" android:layout_height="1dp" android:background="#303030" android:layout_marginBottom="3dp" />
  <LinearLayout android:id="@+id/coc_row_one" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
  <LinearLayout android:id="@+id/coc_row_two" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
  <LinearLayout android:id="@+id/coc_row_three" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
  <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
  <TextView android:id="@+id/coc_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open COCWidget to import a village" android:textSize="12sp" android:textColor="#FFFFFF" android:paddingTop="10dp" android:maxLines="2" android:ellipsize="end" />
  <TextView android:id="@+id/coc_freshness" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saved snapshots · Estimates" android:textSize="10sp" android:textColor="#A3A3A3" android:paddingTop="8dp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
