{
  "expo": {
    "name": "COCWidget",
    "slug": "coc-widget",
    "version": "0.1.0",
    "scheme": "cocwidget",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mosesml.cocwidget"
    },
    "android": {
      "package": "com.mosesml.cocwidget",
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "name": "COCWidget"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.mosesml.cocwidget",
          "enableAndroid": false,
          "widgets": [
            {
              "name": "VillageWidget",
              "displayName": "Your village",
              "description": "Your next useful upgrade and upcoming completions.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "systemLarge"],
                "initialLayout": "src/widgets/VillageWidget.ios.tsx",
                "configuration": {
                  "title": "Choose your village",
                  "description": "Each widget keeps its own selection.",
                  "parameters": {
                    "village": {
                      "title": "Village",
                      "type": "enum",
                      "default": "all",
                      "dynamic": true,
                      "values": [{ "name": "All villages", "value": "all" }]
                    }
                  }
                }
              },
              "android": null
            }
          ]
        }
      ]
    ]
  }
}
