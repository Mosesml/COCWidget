{
  "expo": {
    "name": "COCWidget",
    "slug": "coc-widget",
    "version": "0.1.0",
    "icon": "./assets/app-icon.png",
    "scheme": "cocwidget",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mosesml.cocwidget",
      "deploymentTarget": "17.0"
    },
    "android": {
      "package": "com.mosesml.cocwidget",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101010"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-sharing",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.mosesml.cocwidget",
          "enableAndroid": false,
          "widgets": [
            {
              "name": "VillageWidget",
              "displayName": "Your village",
              "description": "Your next useful upgrade and upcoming completions.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "src/widgets/VillageWidget.ios.tsx",
                "configuration": {
                  "title": "Choose your village",
                  "description": "Each widget keeps its own selection.",
                  "parameters": {
                    "village": {
                      "title": "Village",
                      "type": "enum",
                      "default": "all",
                      "dynamic": true,
                      "values": [
                        {
                          "name": "All villages",
                          "value": "all"
                        }
                      ]
                    }
                  }
                }
              },
              "android": null
            }
          ]
        }
      ]
    ]
  }
}
