{
  "name": "coc-widget",
  "version": "0.1.0",
  "engines": { "node": "^22.13.0 || ^24.3.0 || >=26.0.0" },
  "private": true,
  "expo": {
    "autolinking": {
      "android": { "exclude": ["expo-widgets", "@expo/ui"] }
    }
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:web": "expo export --platform web",
    "check": "npm run typecheck && npm test && npm run build:web",
    "data:sync": "node scripts/sync-catalogue.mjs",
    "test:browser": "playwright test",
    "check:widget-layout": "node node_modules/expo-widgets/scripts/build-layout-registry.mjs . ios .expo/widget-layout.json"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@expo/ui": "~58.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-clipboard": "~58.0.4",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.15",
    "expo-modules-core": "~58.0.29",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-widgets": "~58.0.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
