{
  "name": "coc-widget",
  "version": "0.1.0",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-widgets",
          "@expo/ui"
        ]
      }
    }
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:android": "expo export --platform android --output-dir native-bundles/android",
    "build:ios": "expo export --platform ios --output-dir native-bundles/ios",
    "check": "npm run typecheck && npm run build:scriptable && npm test && npm run build:android && npm run build:ios",
    "data:sync": "node scripts/sync-catalogue.mjs",
    "sync": "node --import tsx scripts/sync-village.ts",
    "export:android": "node --import tsx scripts/export-android.ts",
    "check:widget-layout": "node node_modules/expo-widgets/scripts/build-layout-registry.mjs . ios .expo/widget-layout.json && node scripts/check-ios-widget-runtime.mjs",
    "build:scriptable": "node scripts/build-scriptable.mjs"
  },
  "dependencies": {
    "@expo/ui": "~58.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.15",
    "expo-modules-core": "~58.0.29",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-widgets": "~58.0.26",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "esbuild": "0.28.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
